{
  "name": "nile-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Nile multi-vendor marketplace API (modular monolith)",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:api": "node --watch --env-file=.env dist/server.js",
    "dev:worker": "node --watch --env-file=.env dist/worker.js",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js latest",
    "migrate:rollback": "node dist/migrate.js rollback",
    "migrate:make": "node scripts/make-migration.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "vitest run",
    "dev:env": "node scripts/dev-env.js"
  },
  "dependencies": {
    "amqp-connection-manager": "5.0.0",
    "amqplib": "2.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "class-validator-jsonschema": "5.2.0",
    "cors": "2.8.6",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "knex": "3.3.0",
    "openapi3-ts": "4.6.1",
    "pg": "8.23.0",
    "rate-limiter-flexible": "11.2.1",
    "reflect-metadata": "0.2.2",
    "swagger-ui-express": "5.0.1",
    "tsyringe": "4.10.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/rabbitmq": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  }
}
