            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}/resend-invite",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users",
                "{{targetUserId}}",
                "resend-invite"
              ]
            },
            "description": "New invite link; the previous one stops working. 204. Errors: USER_NOT_FOUND 404, USER_NOT_INVITED 409, VALIDATION_FAILED 400 for an id that is not a UUIDv7."
          }
