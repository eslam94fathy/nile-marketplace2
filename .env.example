# Keys only, never values (CLAUDE.md §4). Every key is required; there are no defaults.
# Local development: `npm run dev:env` creates/completes a git-ignored .env with dev values.
# Each process validates only its own keys (src/lib/config/env.schema.ts, P1-Q1):
#   migrate = common + database · seed-admin = migrate + invite + secrets
#   api = common + database + redis + broker url + http + jwt + rate limits + idempotency + identity + customers + delivery + invite + secrets
#   worker = common + database + redis + broker + jobs + secrets + email
#   realtime = common + database + redis + PORT, TRUST_PROXY_HOPS, CORS_ALLOWED_ORIGINS + jwt verification + realtime
#   Locally the realtime gateway also reads .env.realtime (PORT, SERVICE_NAME), written by `npm run dev:env`.
# JSON values in .env files: wrap them in SINGLE quotes (Node's --env-file does not unescape \").
# PEM keys: one line, newlines written as \n.

# --- common (all processes) ---
NODE_ENV=
SERVICE_NAME=
LOG_LEVEL=
SHUTDOWN_TIMEOUT_MS=
HEALTH_CHECK_TIMEOUT_MS=

# --- database (all processes) ---
DATABASE_URL=
DB_SSL=
DB_POOL_MIN=
DB_POOL_MAX=
DB_STATEMENT_TIMEOUT_MS=

# --- redis (api, worker: realtime emitter, realtime: adapter) ---
REDIS_URL=
REDIS_KEY_PREFIX=

# --- broker (api: connection for readiness; worker: everything) ---
RABBITMQ_URL=
RABBITMQ_EXCHANGE=
RABBITMQ_PREFETCH=
MQ_RETRY_DELAYS_MS=

# --- jobs (worker) ---
OUTBOX_DRAIN_INTERVAL_MS=
OUTBOX_BATCH_SIZE=
OUTBOX_MAX_BACKOFF_MS=
OUTBOX_RETENTION_DAYS=
PROCESSED_EVENTS_RETENTION_DAYS=
CODES_RETENTION_DAYS=
CLEANUP_JOB_INTERVAL_MS=

# --- http (api) ---
PORT=
HTTP_BODY_LIMIT_KB=
TRUST_PROXY_HOPS=
CORS_ALLOWED_ORIGINS=
API_DOCS_ENABLED=
PAGINATION_DEFAULT_LIMIT=
PAGINATION_MAX_LIMIT=

# --- jwt (api). JWT_PUBLIC_KEYS = JSON map kid -> PEM; JWT_ACTIVE_KID must be one of its kids ---
JWT_ALGORITHM=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_PUBLIC_KEYS=
JWT_PRIVATE_KEY=
JWT_ACTIVE_KID=
ACCESS_TOKEN_TTL_MINUTES=
REFRESH_TOKEN_TTL_DAYS=

# --- rate limits and idempotency (api) ---
RATE_LIMIT_GENERAL_POINTS=
RATE_LIMIT_GENERAL_WINDOW_SECONDS=
RATE_LIMIT_STRICT_AUTH_POINTS=
RATE_LIMIT_STRICT_AUTH_WINDOW_SECONDS=
RATE_LIMIT_REFRESH_POINTS=
RATE_LIMIT_REFRESH_WINDOW_SECONDS=
RATE_LIMIT_CHECKOUT_POINTS=
RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=

# --- Upload rate limit, per user (spec 14 ME-6) ---
RATE_LIMIT_UPLOAD_POINTS=
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=
RATE_LIMIT_SUPPORT_MESSAGE_POINTS=
RATE_LIMIT_SUPPORT_MESSAGE_WINDOW_SECONDS=

# --- realtime gateway (spec 15 §6, RT-5) ---
RATE_LIMIT_REALTIME_CONNECT_POINTS=
RATE_LIMIT_REALTIME_CONNECT_WINDOW_SECONDS=
REALTIME_SIGNAL_RATE_PER_SECOND=
IDEMPOTENCY_TTL_HOURS=
IDEMPOTENCY_LOCK_TTL_SECONDS=

# --- identity (api) and invites (api, seed-admin) ---
BCRYPT_COST=
OTP_TTL_MINUTES=
OTP_MAX_ATTEMPTS=
OTP_RESEND_COOLDOWN_SECONDS=
INVITE_TTL_HOURS=
INVITE_URL_BASE=

# --- customers (api) ---
CUSTOMER_MAX_ADDRESSES=
WISHLIST_MAX_ITEMS=

# --- delivery reference data (api) ---
GOVERNORATES_CACHE_TTL_SECONDS=

# --- catalog (api) ---
CATEGORY_TREE_CACHE_TTL_SECONDS=
PRODUCT_DETAIL_CACHE_TTL_SECONDS=
SEARCH_WORD_SIMILARITY_THRESHOLD=

# --- cart (api) ---
CART_MAX_LINES=

# --- ordering (api, worker) ---
SELLER_ACCEPT_TIMEOUT_HOURS=
# api only: the Kashier payment window
KASHIER_PAYMENT_TTL_MINUTES=

# --- ordering jobs (worker) ---
JOB_SELLER_ACCEPTANCE_TIMEOUT_INTERVAL_MS=
JOB_KASHIER_PAYMENT_EXPIRY_INTERVAL_MS=
ORDER_JOBS_BATCH_SIZE=

# --- delivery jobs (worker) ---
JOB_SHIPMENT_ASSIGNMENT_RETRY_INTERVAL_MS=
SHIPMENT_JOBS_BATCH_SIZE=

# --- audit retention (worker, spec 20 §2.4) ---
AUDIT_RETENTION_DAYS=
JOB_AUDIT_RETENTION_INTERVAL_MS=
AUDIT_RETENTION_BATCH_SIZE=

# --- Object storage (spec 14 §6; STORAGE_PROVIDER, _BUCKET, _REGION are derived in AWS) ---
STORAGE_HTTP_TIMEOUT_MS=
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
# minio only
STORAGE_ENDPOINT=
STORAGE_PUBLIC_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Media uploads (spec 14 §1, §6) ---
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_UPLOAD_BYTES=
MEDIA_UPLOAD_URL_TTL_SECONDS=
MEDIA_PRIVATE_URL_TTL_SECONDS=
MEDIA_MAX_OPEN_UPLOADS_PER_USER=
SUPPORT_MAX_OPEN_TICKETS_PER_USER=
REVIEW_WINDOW_DAYS=
REVIEW_EDIT_WINDOW_DAYS=

# --- backoffice (api, spec 20 §3.2) ---
DASHBOARD_CACHE_TTL_SECONDS=

# --- Web Push (spec 13 §8.6, R-20). VAPID keys: `npx web-push generate-vapid-keys` (npm run dev:env does it locally).
# api + worker: the public key and the push-service hosts (exact host or *.domain, comma-separated).
# worker only: the private key (a secret), the mailto: or https: subject, the request timeout.
VAPID_PUBLIC_KEY=
PUSH_ENDPOINT_HOST_ALLOWLIST=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_HTTP_TIMEOUT_MS=

# --- Notification centre retention (worker, spec 13 UC-NO-5) ---
NOTIFICATION_RETENTION_DAYS=
JOB_NOTIFICATION_RETENTION_INTERVAL_MS=
NOTIFICATION_RETENTION_BATCH_SIZE=
SUPPORT_SLA_HOURS=
SUPPORT_AUTO_CLOSE_AFTER_HOURS=
JOB_SUPPORT_INTERVAL_MS=
SUPPORT_JOBS_BATCH_SIZE=

# --- Media cleanup job (spec 14 UC-ME-4) ---
MEDIA_PENDING_RETENTION_HOURS=
JOB_MEDIA_CLEANUP_INTERVAL_MS=
MEDIA_CLEANUP_BATCH_SIZE=

# --- payments (api, worker). PAYMENT_GATEWAY = kashier | fake (fake: development/tests only) ---
# KASHIER_API_KEY signs and verifies webhooks (the fake uses it too). With kashier, KASHIER_MODE=test
# needs KASHIER_BASE_URL=https://test-api.kashier.io and live needs https://api.kashier.io.
# The api also needs the four session keys below. KASHIER_SECRET_KEY can contain `$`: single-quote it,
# e.g. KASHIER_SECRET_KEY='abc$def', so neither Node nor docker compose expands it (spec 10 PA-16).
PAYMENT_GATEWAY=
KASHIER_API_KEY=
KASHIER_HTTP_TIMEOUT_MS=
KASHIER_BASE_URL=
KASHIER_MODE=
# api only
KASHIER_MERCHANT_ID=
KASHIER_SECRET_KEY=
KASHIER_REDIRECT_URL=
KASHIER_WEBHOOK_URL=

# --- secrets in event payloads (api, worker, seed-admin). JSON map kid -> base64 of 32 random bytes ---
SECRETS_ENCRYPTION_KEYS=
SECRETS_ENCRYPTION_ACTIVE_KEY_ID=

# --- email (worker). EMAIL_PROVIDER = mailjet | mailpit (mailpit: development/tests only) ---
EMAIL_PROVIDER=
EMAIL_HTTP_TIMEOUT_MS=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=
# required when EMAIL_PROVIDER=mailjet
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# required when EMAIL_PROVIDER=mailpit
MAILPIT_URL=
