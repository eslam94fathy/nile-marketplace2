# Production (architecture §13.1). Written and checked offline in P8; applied only at the go-live step,
# with its own approval (P8-Q3). Needs the mobile team's app links (P8-Q11).

terraform {
  required_version = "~> 1.16.4"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "6.64.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "3.8.1"
    }
  }
  # Partial configuration: bucket, kms_key_id and region come from backend.hcl (bootstrap outputs).
  backend "s3" {
    key          = "prod/terraform.tfstate"
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region = var.region
  default_tags {
    tags = { Project = "nile-marketplace", Environment = "prod", ManagedBy = "terraform" }
  }
}

module "environment" {
  source           = "../../modules/environment"
  environment_name = "prod"
  region           = var.region
  cidr_block       = "10.30.0.0/16"
  domain_name      = var.domain_name
  route53_zone_id  = var.route53_zone_id
  alert_email      = var.alert_email
  image_tag        = var.image_tag

  sizes = {
    nat_gateway_count         = 2
    log_retention_days        = 90
    deletion_protection       = true
    container_insights        = true
    rds_instance_class        = "db.m7g.large"
    rds_multi_az              = true
    rds_storage_gb            = 100
    rds_max_storage_gb        = 500
    rds_backup_retention_days = 14
    redis_node_type           = "cache.t4g.small"
    mq_instance_type          = "mq.m7g.medium"
    api_cpu                   = 512
    api_memory                = 1024
    api_desired_count         = 2
    api_autoscaling           = { min = 2, max = 4, cpu_target_percent = 60 }
    worker_cpu                = 512
    worker_memory             = 1024
    worker_desired_count      = 2
    error_log_alarm_threshold = 5
    alb_5xx_alarm_threshold   = 10
  }

  # Every non-secret setting, explicitly (CLAUDE.md §4). Values from the approved decisions
  # (P1-Q4, P2-Q5, P3-Q9, P4-Q10, P5-Q10, P6-Q9) unless noted.
  settings = {
    LOG_LEVEL               = "info"
    SHUTDOWN_TIMEOUT_MS     = "20000"
    HEALTH_CHECK_TIMEOUT_MS = "2000"
    DB_POOL_MIN             = "0"
    DB_POOL_MAX             = "10"
    DB_STATEMENT_TIMEOUT_MS = "10000"
    REDIS_KEY_PREFIX        = "nile:prod:"

    HTTP_BODY_LIMIT_KB       = "100"
    CORS_ALLOWED_ORIGINS     = ""      # mobile app only
    API_DOCS_ENABLED         = "false" # never in production (P0-Q4, review F-3)
    PAGINATION_DEFAULT_LIMIT = "20"
    PAGINATION_MAX_LIMIT     = "100"

    JWT_ISSUER               = "nile-prod"
    JWT_AUDIENCE             = "nile-app"
    JWT_ACTIVE_KID           = var.jwt_active_kid
    ACCESS_TOKEN_TTL_MINUTES = "15"
    REFRESH_TOKEN_TTL_DAYS   = "30"

    RATE_LIMIT_GENERAL_POINTS             = "600"
    RATE_LIMIT_GENERAL_WINDOW_SECONDS     = "60"
    RATE_LIMIT_STRICT_AUTH_POINTS         = "10"
    RATE_LIMIT_STRICT_AUTH_WINDOW_SECONDS = "300"
    RATE_LIMIT_REFRESH_POINTS             = "30"
    RATE_LIMIT_REFRESH_WINDOW_SECONDS     = "300"
    RATE_LIMIT_CHECKOUT_POINTS            = "10"
    RATE_LIMIT_CHECKOUT_WINDOW_SECONDS    = "60"
    RATE_LIMIT_UPLOAD_POINTS              = "30"
    RATE_LIMIT_UPLOAD_WINDOW_SECONDS      = "600"
    IDEMPOTENCY_TTL_HOURS                 = "24"
    IDEMPOTENCY_LOCK_TTL_SECONDS          = "60" # above the longest request (review F-9)

    # support (spec 16 §1, §6): ticket opens and message posts per user, open tickets per user (R-8).
    RATE_LIMIT_SUPPORT_MESSAGE_POINTS         = "30"
    RATE_LIMIT_SUPPORT_MESSAGE_WINDOW_SECONDS = "60"
    SUPPORT_MAX_OPEN_TICKETS_PER_USER         = "20"

    # reviews (spec 17 §1, R-10): write until delivery + 60 days, edit until creation + 30 days.
    REVIEW_WINDOW_DAYS      = "60"
    REVIEW_EDIT_WINDOW_DAYS = "30"

    # realtime gateway (spec 15 §6): a reconnect per tab every 15 min, plus deploy storms (RT-5).
    RATE_LIMIT_REALTIME_CONNECT_POINTS         = "60"
    RATE_LIMIT_REALTIME_CONNECT_WINDOW_SECONDS = "60"
    REALTIME_SIGNAL_RATE_PER_SECOND            = "5"

    # Web Push (spec 13 §8.6). The key pair is generated by hand; the private key is a secret (R2-Q7).
    VAPID_PUBLIC_KEY             = var.vapid_public_key
    VAPID_SUBJECT                = var.vapid_subject
    PUSH_HTTP_TIMEOUT_MS         = "10000"
    PUSH_ENDPOINT_HOST_ALLOWLIST = "fcm.googleapis.com,updates.push.services.mozilla.com,*.notify.windows.com,web.push.apple.com"

    BCRYPT_COST                 = "12"
    OTP_TTL_MINUTES             = "10"
    OTP_MAX_ATTEMPTS            = "5"
    OTP_RESEND_COOLDOWN_SECONDS = "60"
    INVITE_TTL_HOURS            = "72"
    INVITE_URL_BASE             = var.invite_url_base

    CUSTOMER_MAX_ADDRESSES           = "20"
    WISHLIST_MAX_ITEMS               = "200"
    GOVERNORATES_CACHE_TTL_SECONDS   = "3600"
    CATEGORY_TREE_CACHE_TTL_SECONDS  = "3600"
    PRODUCT_DETAIL_CACHE_TTL_SECONDS = "60"
    SEARCH_WORD_SIMILARITY_THRESHOLD = "0.35" # tuned by the load baseline (P8-Q13)
    CART_MAX_LINES                   = "50"

    SELLER_ACCEPT_TIMEOUT_HOURS = "24"
    KASHIER_PAYMENT_TTL_MINUTES = "15"
    KASHIER_HTTP_TIMEOUT_MS     = "10000"
    KASHIER_BASE_URL            = "https://api.kashier.io"
    KASHIER_MODE                = "live"
    KASHIER_REDIRECT_URL        = var.kashier_redirect_url

    SECRETS_ENCRYPTION_ACTIVE_KEY_ID = var.secrets_encryption_active_key_id

    RABBITMQ_EXCHANGE                         = "nile.events"
    RABBITMQ_PREFETCH                         = "20"
    MQ_RETRY_DELAYS_MS                        = "5000,30000,300000"
    OUTBOX_DRAIN_INTERVAL_MS                  = "1000"
    OUTBOX_BATCH_SIZE                         = "100"
    OUTBOX_MAX_BACKOFF_MS                     = "300000"
    OUTBOX_RETENTION_DAYS                     = "7"
    PROCESSED_EVENTS_RETENTION_DAYS           = "30"
    CODES_RETENTION_DAYS                      = "30"
    CLEANUP_JOB_INTERVAL_MS                   = "86400000"
    JOB_SELLER_ACCEPTANCE_TIMEOUT_INTERVAL_MS = "60000"
    JOB_KASHIER_PAYMENT_EXPIRY_INTERVAL_MS    = "30000"
    ORDER_JOBS_BATCH_SIZE                     = "100"
    JOB_SHIPMENT_ASSIGNMENT_RETRY_INTERVAL_MS = "60000"
    SHIPMENT_JOBS_BATCH_SIZE                  = "100"
    AUDIT_RETENTION_DAYS                      = "730"
    JOB_AUDIT_RETENTION_INTERVAL_MS           = "86400000"
    AUDIT_RETENTION_BATCH_SIZE                = "1000"
    STORAGE_HTTP_TIMEOUT_MS                   = "5000"
    MEDIA_PUBLIC_BASE_URL                     = var.media_public_base_url
    MEDIA_MAX_UPLOAD_BYTES                    = "5242880"
    MEDIA_UPLOAD_URL_TTL_SECONDS              = "300"
    MEDIA_PRIVATE_URL_TTL_SECONDS             = "600"
    MEDIA_MAX_OPEN_UPLOADS_PER_USER           = "20"
    MEDIA_PENDING_RETENTION_HOURS             = "24"
    JOB_MEDIA_CLEANUP_INTERVAL_MS             = "3600000"
    MEDIA_CLEANUP_BATCH_SIZE                  = "100"
    NOTIFICATION_RETENTION_DAYS               = "90"
    JOB_NOTIFICATION_RETENTION_INTERVAL_MS    = "86400000"
    NOTIFICATION_RETENTION_BATCH_SIZE         = "1000"
    SUPPORT_SLA_HOURS                         = "24"
    SUPPORT_AUTO_CLOSE_AFTER_HOURS            = "168"
    JOB_SUPPORT_INTERVAL_MS                   = "60000"
    SUPPORT_JOBS_BATCH_SIZE                   = "100"

    EMAIL_HTTP_TIMEOUT_MS = "10000"
    MAILJET_FROM_EMAIL    = var.mailjet_from_email
    MAILJET_FROM_NAME     = "Nile"
  }
}
